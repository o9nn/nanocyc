/* ============================================================================
 * DEMO 22: Parallel Supply-Chain Ledger (1000 entities, synchronous steps)
 * ============================================================================ */

@demo parallel_ledger_demo
{
    @description "Chart of accounts for a supply chain: all entities settle in
     * a constant number of maximally-parallel membrane steps, independent of
     * entity count."

    @membrane_structure
    {
        /* Each entity is a membrane holding account{acct, balance} objects.
         * A double-entry transfer moves value between two entities' matching
         * accounts.  Because evolution rules are maximally parallel, EVERY
         * entity's ledger updates in the same step. */
        [ledger
            for (e = 1; e <= 1000; e++)
            {
                [entity{e}
                    account{cash, 10000}
                    account{receivable, 2500}
                    account{payable, 1800}
                    account{inventory, 5000}
                ]'ledger
            }
            /* Pending inter-entity transfers: transfer{from, to, acct, amt} */
            transfer{1, 2, cash, 500}
            transfer{2, 3, cash, 300}
            transfer{7, 42, inventory, 1200}
        ]'main
    }

    @execution
    {
        /* Double-entry rule: debit source, credit destination -- applied to
         * ALL transfers simultaneously in one maximally-parallel step. */
        [transfer{F, T, acct, amt},
         account{acct, bf}]'entity{F}
        [account{acct, bt}]'entity{T} ->
            [account{acct, bf - amt}]'entity{F}
            [account{acct, bt + amt}]'entity{T}

        []'main (display{
            "Parallel Supply-Chain Ledger",
            "Entities": 1000,
            "Accounts/entity": 4,
            "Key property": "settlement is O(1) membrane steps, NOT O(n)",
            "Step 1": "all pending transfers settle simultaneously",
            "Invariants": "double-entry conservation holds by construction",
            "Why": "maximal parallelism = every entity's rules fire together"
        }, out)
    }
}

