/* ============================================================================
 * DEMO 24: Mixed-Radix Parallel Operations (membrane arity topologies)
 * ============================================================================ */

@demo mixed_radix_demo
{
    @description "Binary, ternary, quaternionic and quinternary bases execute
     * their ops in the SAME maximally-parallel step"

    @membrane_structure
    {
        [topology
            binary_basis(4)        /* [2]^4  = 16 lanes   */
            ternary_basis(3)       /* [3]^3  = 27 lanes   */
            quaternionic_basis(2)  /* [2|2]^2 = 16 states */
            quinternary_basis(2)   /* [5]^2  = 25 lanes   */

            /* A membrane tree to be Matula-indexed */
            leaf{a}
            parent{root, a}
            prime{1, 2}

            /* Candidate topologies for partition selection */
            fit{t1, 40}
            fit{t2, 85}
            fit{t3, 60}
        ]'main
    }

    @execution
    {
        matula_index
        partition_selection

        []'main (display{
            "Mixed-Radix Membrane Parallelism",
            "[2]^4 binary": "16 lanes, one step",
            "[3]^3 ternary": "27 lanes, one step",
            "[2|2]^2 quaternionic": "16 orthogonal states, one step",
            "[5]^2 quinternary": "25 lanes, one step",
            "Matula index": "root over a leaf -> p_1 = 2 (canonical shape id)",
            "Partition selection": "fittest topology t2 (0.85) selected as root",
            "Insight": "membrane shape = arity of a categorical logic;"
        }, out)
    }
}

/* ============================================================================
 * DEMO 25: P-Systems <-> B-Series Bridge
 * ============================================================================ */

@demo bseries_bridge_demo
{
    @description "Plant rooted trees in membrane nests and run P-System
     * evolution and B-series gradient descent in the same parallel step"

    @membrane_structure
    {
        [bridge
            /* A chain tree (order 2) planted in its nest via Matula no. */
            tree{chain}
            matula{chain, 2}       /* p_1 = 2: one node over a leaf */
            order{chain, 2}
            density{chain, 2}
            symmetry{chain, 1}

            /* A parameter to update by the B-series-weighted gradient */
            weight{1, 1000}
            grad{1, 200}
            lr{50}                 /* 0.50 */

            /* Candidate topologies for orbifold root selection */
            fit{chain, 60}
            fit{bush, 85}
        ]'main
    }

    @execution
    {
        tree_nest_bridge
        elementary_weights
        bseries_gradient_step(50)
        rk_order_conditions
        orbifold_quotient

        []'main (display{
            "P-Systems <-> B-Series Bridge",
            "Shared topology": "chain tree planted in nest 2 (Matula p_1)",
            "Elementary weight": "chain: order=2, density=2, b=1/2",
            "Gradient as flow": "w <- w - lr*grad/(s*g) = 10 - 0.5*2/2",
            "Order condition": "sum b(t) = 1  (exact rational)",
            "Orbifold": "isomorphic trees canonify to minimal Matula",
            "Unification": "membrane evolution IS the integrator stage;",
            "": "adaptation (gradient) and niche construction (evolution) share one law"
        }, out)
    }
}

/* ============================================================================
 * DEMO 26: Closure Isomorphism & the Frame Problem
 * ============================================================================ */

@demo closure_frame_demo
{
    @description "{circle~cycle~closure}: one closure in spatial/temporal/causal
     * frames -> .mli CNN, .gli RNN, .nli GNN; ennead solves the frame problem;
     * the gauge field is the curvature lever (Ricci-flow relevance)"

    @membrane_structure
    {
        [frames
            spatial{nbhd}          /* -> structural closure (CNN)   */
            temporal{step}         /* -> procedural closure (RNN)   */
            causal{aggregate}      /* -> relational closure (GNN)   */
        ]'main

        [ennead
            ennead{agent, spatial, 50}
            ennead{arena, temporal, 52}
            ennead{relation, causal, 51}
        ]'main

        [gauge
            metric{100}
            ricci{25}              /* convex curvature */
            connection{A}
            loop{L}
        ]'main
    }

    @execution
    {
        closure_isomorphism
        ennead_frame
        ricci_relevance

        []'main (display{
            "Closure Isomorphism: {circle ~ cycle ~ closure}",
            "Spatial  (.mli)": "structural closure = receptive field -> CNN",
            "Temporal (.gli)": "procedural closure = recurrence -> RNN",
            "Causal   (.nli)": "relational closure = message passing -> GNN",
            "Ennead 3x3": "poles x frames; low spread => frame problem solved",
            "Curvature lever": "the gauge field (connection); holonomy = curvature",
            "Ricci flow": "g' = g - 2*Ric*g ; sign drives Noether currents"
        }, out)
    }
}

