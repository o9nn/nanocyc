    [test_suite
        total_tests{t}
        passed_tests{p}
        failed_tests{f}
    ]'main ->
    {
        []'main (
            test_results{
                "Total Tests": t,
                "Passed": p,
                "Failed": f,
                "Success Rate": (p*100)/t + "%"
            },
            out
        )
    }
}

