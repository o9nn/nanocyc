/* ============================================================================
 * psystems/ch01/ch01_decision_making.pli
 *
 * NanoBrain CH01: Philosophical transformation essential to reverse engineer consciousness
 * Issue #6 — P-Lingua specification (see psystems/README.md).
 *
 * Sections: 1.6
 * Functionality: Brain-inspired decision making: outline of key discoveries as a decision rule chain.
 * Traceability: src/cpp/nanobrain_philosophical.h, nanobrain_unified.h
 * Initial multiset: sample objects in each membrane so the simulator can run
 *                   at least one evolution step.
 * ==========================================================================*/

@model<psystems_basic>

/* Membrane structure: skin with one membrane per functional unit. */
@mu = [ []'perceive []'integrate []'decide ]'skin;

@mskin = seed;
@mperceive = unit(perceive), fuel;
@mintegrate = unit(integrate), fuel;
@mdecide = unit(decide), fuel;

/* --------------------------------------------------------------------------
 * Evolution rules
 * seed_dispense : the skin injects a work token into each functional membrane
 * step_%s-local : each membrane transforms its unit object and consumes fuel
 * report        : finished results are sent out to the skin
 * ------------------------------------------------------------------------*/
[seed_dispense : seed --> (work)in_perceive ]'skin;
[seed_dispense : seed --> (work)in_integrate ]'skin;
[seed_dispense : seed --> (work)in_decide ]'skin;
[step : work * unit(perceive) * fuel --> done(perceive) ]'perceive;
[step : work * unit(integrate) * fuel --> done(integrate) ]'integrate;
[step : work * unit(decide) * fuel --> done(decide) ]'decide;
[report : done(perceive) --> (result(perceive))out ]'perceive;
[report : done(integrate) --> (result(integrate))out ]'integrate;
[report : done(decide) --> (result(decide))out ]'decide;
