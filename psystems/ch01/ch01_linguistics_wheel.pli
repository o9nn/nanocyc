/* ============================================================================
 * psystems/ch01/ch01_linguistics_wheel.pli
 *
 * NanoBrain CH01: Philosophical transformation essential to reverse engineer consciousness
 * Issue #6 — P-Lingua specification (see psystems/README.md).
 *
 * Sections: 1.9
 * Functionality: Linguistics and the wheel of space, time and imaginary worlds: three rotating membranes exchanging objects cyclically.
 * Traceability: src/cpp/nanobrain_philosophical.h, nanobrain_unified.h
 * Initial multiset: sample objects in each membrane so the simulator can run
 *                   at least one evolution step.
 * ==========================================================================*/

@model<psystems_basic>

/* Membrane structure: skin with one membrane per functional unit. */
@mu = [ []'space []'time []'imaginary ]'skin;

@mskin = seed;
@mspace = unit(space), fuel;
@mtime = unit(time), fuel;
@mimaginary = unit(imaginary), fuel;

/* --------------------------------------------------------------------------
 * Evolution rules
 * seed_dispense : the skin injects a work token into each functional membrane
 * step_%s-local : each membrane transforms its unit object and consumes fuel
 * report        : finished results are sent out to the skin
 * ------------------------------------------------------------------------*/
[seed_dispense : seed --> (work)in_space ]'skin;
[seed_dispense : seed --> (work)in_time ]'skin;
[seed_dispense : seed --> (work)in_imaginary ]'skin;
[step : work * unit(space) * fuel --> done(space) ]'space;
[step : work * unit(time) * fuel --> done(time) ]'time;
[step : work * unit(imaginary) * fuel --> done(imaginary) ]'imaginary;
[report : done(space) --> (result(space))out ]'space;
[report : done(time) --> (result(time))out ]'time;
[report : done(imaginary) --> (result(imaginary))out ]'imaginary;
