/* ============================================================================
 * psystems/ch09/ch09_fractal_reaction_kinetics.pli
 *
 * NanoBrain CH09: Brain jelly to humanoid avatar: fractal reaction kinetics, fractal condensation, programmable matter for primes
 * Issue #14 — P-Lingua specification (see psystems/README.md).
 *
 * Sections: 9.6
 * Functionality: Fractal reaction kinetics: many syntheses in one beaker at a time — parallel reaction membranes.
 * Traceability: src/cpp/nanobrain_brain_jelly.h
 * Initial multiset: sample objects in each membrane so the simulator can run
 *                   at least one evolution step.
 * ==========================================================================*/

@model<psystems_basic>

/* Membrane structure: skin with one membrane per functional unit. */
@mu = [ []'beaker_a []'beaker_b []'beaker_c ]'skin;

@mskin = seed;
@mbeaker_a = unit(beaker_a), fuel;
@mbeaker_b = unit(beaker_b), fuel;
@mbeaker_c = unit(beaker_c), fuel;

/* --------------------------------------------------------------------------
 * Evolution rules
 * seed_dispense : the skin injects a work token into each functional membrane
 * step_%s-local : each membrane transforms its unit object and consumes fuel
 * report        : finished results are sent out to the skin
 * ------------------------------------------------------------------------*/
[seed_dispense : seed --> (work)in_beaker_a ]'skin;
[seed_dispense : seed --> (work)in_beaker_b ]'skin;
[seed_dispense : seed --> (work)in_beaker_c ]'skin;
[step : work * unit(beaker_a) * fuel --> done(beaker_a) ]'beaker_a;
[step : work * unit(beaker_b) * fuel --> done(beaker_b) ]'beaker_b;
[step : work * unit(beaker_c) * fuel --> done(beaker_c) ]'beaker_c;
[report : done(beaker_a) --> (result(beaker_a))out ]'beaker_a;
[report : done(beaker_b) --> (result(beaker_b))out ]'beaker_b;
[report : done(beaker_c) --> (result(beaker_c))out ]'beaker_c;
