/* ============================================================================
 * psystems/ch09/ch09_biomorphic_devices.pli
 *
 * NanoBrain CH09: Brain jelly to humanoid avatar. Issue #14 — P-Lingua
 * specification (see psystems/README.md).
 *
 * Section: 9.1 — Neuromorphic devices are not alone: 17 bio-morphic devices
 *                sing together.
 *
 * Functionality: Neuromorphic hardware is only ONE voice. The brain jelly
 *   assembles SEVENTEEN bio-morphic device archetypes — the fundamental
 *   neuristors (neuristor, memristor, synapstor, denristor, axonistor), the
 *   glial family (gliaistor, astrocystor, oligodendrocystor, microglisator,
 *   ependymistor) and the specialized cortical/cerebellar neurons
 *   (purkinjistor, pyramidistor, stellatistor, granulistor, basketistor,
 *   chandelieristor, martinottistor). Each device membrane runs the same
 *   integrate-and-fire cycle (activate -> threshold -> fire -> refractory),
 *   and the seventeen voices are phase-locked into ONE CHORUS: devices do not
 *   shout at each other pairwise — every one emits a tone into the shared
 *   skin medium, and a singing chord is born only when all seventeen tones
 *   are simultaneously present. Synchronization is the music; the chord is
 *   the collective response of the device registry.
 *
 *   Common modules inlined by convention:
 *     common/ecan_attention.pli — each device pays fuel-rent per cycle and
 *                                 is paid a work wage by the skin bank; the
 *                                 wage/rent economy keeps the chorus alive
 *
 * Traceability: src/cpp/nanobrain_brain_jelly.h
 *               (BioMorphicDeviceType — the 17 archetypes;
 *                BioMorphicDevice — activation_level/threshold/refractory;
 *                BioMorphicDeviceRegistry — update_all_devices,
 *                propagate_signals, compute_collective_response;
 *                CollectiveResponse — synchronization_index, harmonic_modes)
 * Initial multiset: one baton and one seed tone in the skin; every device
 *                   membrane holds a fresh voice and a unit of fuel, so the
 *                   simulator runs >= 1 step in every membrane.
 * ==========================================================================*/

@model<psystems_basic>

/* --------------------------------------------------------------------------
 * Membrane structure:
 *   skin (the shared medium — the concert hall)
 *     '- chorus : the conductor membrane where the 17 tones fuse
 *     '- dev_neuristor  ... dev_martinottistor : the 17 device voices
 *        (5 neuristors, 5 glial devices, 7 specialized neurons)
 * ------------------------------------------------------------------------*/
@mu = [ []'chorus
        []'dev_neuristor []'dev_memristor []'dev_synapstor []'dev_denristor
        []'dev_axonistor
        []'dev_gliaistor []'dev_astrocystor []'dev_oligodendrocystor
        []'dev_microglisator []'dev_ependymistor
        []'dev_purkinjistor []'dev_pyramidistor []'dev_stellatistor
        []'dev_granulistor []'dev_basketistor []'dev_chandelieristor
        []'dev_martinottistor ]'skin;

/* Sample initial multiset. */
@mskin                 = baton, seed_tone;
@mchorus               = tonic;
@mdev_neuristor        = voice(neuristor),        fuel;
@mdev_memristor        = voice(memristor),        fuel;
@mdev_synapstor        = voice(synapstor),        fuel;
@mdev_denristor        = voice(denristor),        fuel;
@mdev_axonistor        = voice(axonistor),        fuel;
@mdev_gliaistor        = voice(gliaistor),        fuel;
@mdev_astrocystor      = voice(astrocystor),      fuel;
@mdev_oligodendrocystor = voice(oligodendrocystor), fuel;
@mdev_microglisator    = voice(microglisator),    fuel;
@mdev_ependymistor     = voice(ependymistor),     fuel;
@mdev_purkinjistor     = voice(purkinjistor),     fuel;
@mdev_pyramidistor     = voice(pyramidistor),     fuel;
@mdev_stellatistor     = voice(stellatistor),     fuel;
@mdev_granulistor      = voice(granulistor),      fuel;
@mdev_basketistor      = voice(basketistor),      fuel;
@mdev_chandelieristor  = voice(chandelieristor),  fuel;
@mdev_martinottistor   = voice(martinottistor),   fuel;

/* --------------------------------------------------------------------------
 * 9.1  The conductor calls and every voice answers.
 * conduct  : the baton broadcasts the seed tone into every device membrane —
 *            no device sings alone; the call reaches all seventeen at once
 * activate : a voice integrates the incoming tone against its fuel — the
 *            device activation_level rises (one tone quantum per cycle)
 * fire     : activation crosses the firing threshold — the device EMITS its
 *            characteristic tone into the shared medium (send-out to skin)
 * refract  : after firing, the voice resets — the refractory period restores
 *            a fresh voice so the device can sing the next cycle
 * ------------------------------------------------------------------------*/
[conduct : baton * seed_tone
        --> (tone)in_dev_neuristor * (tone)in_dev_memristor
          * (tone)in_dev_synapstor * (tone)in_dev_denristor
          * (tone)in_dev_axonistor
          * (tone)in_dev_gliaistor * (tone)in_dev_astrocystor
          * (tone)in_dev_oligodendrocystor * (tone)in_dev_microglisator
          * (tone)in_dev_ependymistor
          * (tone)in_dev_purkinjistor * (tone)in_dev_pyramidistor
          * (tone)in_dev_stellatistor * (tone)in_dev_granulistor
          * (tone)in_dev_basketistor * (tone)in_dev_chandelieristor
          * (tone)in_dev_martinottistor ]'skin;

[activate : voice(neuristor) * tone * fuel
         --> fired(neuristor) ]'dev_neuristor;
[activate : voice(memristor) * tone * fuel
         --> fired(memristor) ]'dev_memristor;
[activate : voice(synapstor) * tone * fuel
         --> fired(synapstor) ]'dev_synapstor;
[activate : voice(denristor) * tone * fuel
         --> fired(denristor) ]'dev_denristor;
[activate : voice(axonistor) * tone * fuel
         --> fired(axonistor) ]'dev_axonistor;
[activate : voice(gliaistor) * tone * fuel
         --> fired(gliaistor) ]'dev_gliaistor;
[activate : voice(astrocystor) * tone * fuel
         --> fired(astrocystor) ]'dev_astrocystor;
[activate : voice(oligodendrocystor) * tone * fuel
         --> fired(oligodendrocystor) ]'dev_oligodendrocystor;
[activate : voice(microglisator) * tone * fuel
         --> fired(microglisator) ]'dev_microglisator;
[activate : voice(ependymistor) * tone * fuel
         --> fired(ependymistor) ]'dev_ependymistor;
[activate : voice(purkinjistor) * tone * fuel
         --> fired(purkinjistor) ]'dev_purkinjistor;
[activate : voice(pyramidistor) * tone * fuel
         --> fired(pyramidistor) ]'dev_pyramidistor;
[activate : voice(stellatistor) * tone * fuel
         --> fired(stellatistor) ]'dev_stellatistor;
[activate : voice(granulistor) * tone * fuel
         --> fired(granulistor) ]'dev_granulistor;
[activate : voice(basketistor) * tone * fuel
         --> fired(basketistor) ]'dev_basketistor;
[activate : voice(chandelieristor) * tone * fuel
         --> fired(chandelieristor) ]'dev_chandelieristor;
[activate : voice(martinottistor) * tone * fuel
         --> fired(martinottistor) ]'dev_martinottistor;

[fire : fired(neuristor)        --> voice(neuristor)        * (sung(neuristor))out ]'dev_neuristor;
[fire : fired(memristor)        --> voice(memristor)        * (sung(memristor))out ]'dev_memristor;
[fire : fired(synapstor)        --> voice(synapstor)        * (sung(synapstor))out ]'dev_synapstor;
[fire : fired(denristor)        --> voice(denristor)        * (sung(denristor))out ]'dev_denristor;
[fire : fired(axonistor)        --> voice(axonistor)        * (sung(axonistor))out ]'dev_axonistor;
[fire : fired(gliaistor)        --> voice(gliaistor)        * (sung(gliaistor))out ]'dev_gliaistor;
[fire : fired(astrocystor)      --> voice(astrocystor)      * (sung(astrocystor))out ]'dev_astrocystor;
[fire : fired(oligodendrocystor) --> voice(oligodendrocystor) * (sung(oligodendrocystor))out ]'dev_oligodendrocystor;
[fire : fired(microglisator)    --> voice(microglisator)    * (sung(microglisator))out ]'dev_microglisator;
[fire : fired(ependymistor)     --> voice(ependymistor)     * (sung(ependymistor))out ]'dev_ependymistor;
[fire : fired(purkinjistor)     --> voice(purkinjistor)     * (sung(purkinjistor))out ]'dev_purkinjistor;
[fire : fired(pyramidistor)     --> voice(pyramidistor)     * (sung(pyramidistor))out ]'dev_pyramidistor;
[fire : fired(stellatistor)     --> voice(stellatistor)     * (sung(stellatistor))out ]'dev_stellatistor;
[fire : fired(granulistor)      --> voice(granulistor)      * (sung(granulistor))out ]'dev_granulistor;
[fire : fired(basketistor)      --> voice(basketistor)      * (sung(basketistor))out ]'dev_basketistor;
[fire : fired(chandelieristor)  --> voice(chandelieristor)  * (sung(chandelieristor))out ]'dev_chandelieristor;
[fire : fired(martinottistor)   --> voice(martinottistor)   * (sung(martinottistor))out ]'dev_martinottistor;

/* --------------------------------------------------------------------------
 * The chorus: seventeen tones fuse into one chord.
 * gather   : the skin routes every sung tone into the chorus membrane
 * chord    : all seventeen tones are present at once — they fuse into the
 *            singing chord (synchronization_index = 1); the tonic catalyst
 *            anchors the harmony
 * collective: the chord is the COLLECTIVE RESPONSE — the registry certifies
 *            that neuromorphic devices are not alone anymore
 * ------------------------------------------------------------------------*/
[gather : sung(D) --> (sung(D))in_chorus ]'skin;

[chord : tonic * sung(neuristor) * sung(memristor) * sung(synapstor)
          * sung(denristor) * sung(axonistor)
          * sung(gliaistor) * sung(astrocystor) * sung(oligodendrocystor)
          * sung(microglisator) * sung(ependymistor)
          * sung(purkinjistor) * sung(pyramidistor) * sung(stellatistor)
          * sung(granulistor) * sung(basketistor) * sung(chandelieristor)
          * sung(martinottistor)
       --> tonic * (chord(17))out ]'chorus;

[collective : chord(17) --> biomorphic_chorus(singing) ]'skin;
