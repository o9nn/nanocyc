/* ============================================================================
 * psystems/ch09/ch09_seeking_sensor.pli
 *
 * NanoBrain CH09: Brain jelly to humanoid avatar: fractal reaction kinetics, fractal condensation, programmable matter for primes
 * Issue #14 — P-Lingua specification (see psystems/README.md).
 *
 * Sections: 9.11, 9.11.1-9.11.2
 * Functionality: A sensor that seeks, does not wait; 11-dimensional signals in the human brain and brain jelly; humanoid avatar as the ultimate sensor.
 * Traceability: src/cpp/nanobrain_brain_jelly.h
 * Initial multiset: sample objects in each membrane so the simulator can run
 *                   at least one evolution step.
 * ==========================================================================*/

@model<psystems_basic>

/* Membrane structure: skin with one membrane per functional unit. */
@mu = [ []'seeker []'signals_11d []'avatar ]'skin;

@mskin = seed;
@mseeker = unit(seeker), fuel;
@msignals_11d = unit(signals_11d), fuel;
@mavatar = unit(avatar), fuel;

/* --------------------------------------------------------------------------
 * Evolution rules
 * seed_dispense : the skin injects a work token into each functional membrane
 * step_%s-local : each membrane transforms its unit object and consumes fuel
 * report        : finished results are sent out to the skin
 * ------------------------------------------------------------------------*/
[seed_dispense : seed --> (work)in_seeker ]'skin;
[seed_dispense : seed --> (work)in_signals_11d ]'skin;
[seed_dispense : seed --> (work)in_avatar ]'skin;
[step : work * unit(seeker) * fuel --> done(seeker) ]'seeker;
[step : work * unit(signals_11d) * fuel --> done(signals_11d) ]'signals_11d;
[step : work * unit(avatar) * fuel --> done(avatar) ]'avatar;
[report : done(seeker) --> (result(seeker))out ]'seeker;
[report : done(signals_11d) --> (result(signals_11d))out ]'signals_11d;
[report : done(avatar) --> (result(avatar))out ]'avatar;
