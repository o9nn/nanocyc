/* ============================================================================
 * psystems/ch09/ch09_magnetic_light_reading.pli
 *
 * NanoBrain CH09: Brain jelly to humanoid avatar: fractal reaction kinetics, fractal condensation, programmable matter for primes
 * Issue #14 — P-Lingua specification (see psystems/README.md).
 *
 * Sections: 9.8, 9.8.1-9.8.2
 * Functionality: Tuning undefined holes to read magnetic light; a spiral nanowire writes a time crystal, read it as a crystal of light; writing prime numbers in a jelly.
 * Traceability: src/cpp/nanobrain_brain_jelly.h
 * Initial multiset: sample objects in each membrane so the simulator can run
 *                   at least one evolution step.
 * ==========================================================================*/

@model<psystems_basic>

/* Membrane structure: skin with one membrane per functional unit. */
@mu = [ []'holes []'nanowire []'prime_write ]'skin;

@mskin = seed;
@mholes = unit(holes), fuel;
@mnanowire = unit(nanowire), fuel;
@mprime_write = unit(prime_write), fuel;

/* --------------------------------------------------------------------------
 * Evolution rules
 * seed_dispense : the skin injects a work token into each functional membrane
 * step_%s-local : each membrane transforms its unit object and consumes fuel
 * report        : finished results are sent out to the skin
 * ------------------------------------------------------------------------*/
[seed_dispense : seed --> (work)in_holes ]'skin;
[seed_dispense : seed --> (work)in_nanowire ]'skin;
[seed_dispense : seed --> (work)in_prime_write ]'skin;
[step : work * unit(holes) * fuel --> done(holes) ]'holes;
[step : work * unit(nanowire) * fuel --> done(nanowire) ]'nanowire;
[step : work * unit(prime_write) * fuel --> done(prime_write) ]'prime_write;
[report : done(holes) --> (result(holes))out ]'holes;
[report : done(nanowire) --> (result(nanowire))out ]'nanowire;
[report : done(prime_write) --> (result(prime_write))out ]'prime_write;
