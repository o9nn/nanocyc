/* ============================================================================
 * psystems/ch09/ch09_fractal_condensation.pli
 *
 * NanoBrain CH09: Brain jelly to humanoid avatar. Issue #14 — P-Lingua
 * specification (see psystems/README.md).
 *
 * Sections: 9.5   — Fractal condensation: condensing everywhere at a time,
 *           9.5.1 — Pattern of primes need not be told.
 *
 * Functionality: Condensation in the brain jelly is FRACTAL (9.5): it does
 *   not happen at one site after another — a single condensation seed fans
 *   out into nested regions, and each region condenses at EVERY point AT
 *   THE SAME TIME. The condensation field is self-similar: every region
 *   holds a sub-region of its own, and a condensation front reaching a
 *   region condenses the region and all its children in one step, so the
 *   whole tree condenses everywhere at a time. The pattern of primes that
 *   guides condensation NEED NOT BE TOLD (9.5.1): it is not read from any
 *   program — it EMERGES from the condensation itself. As points condense,
 *   their ordered prime factors self-organize into the prime pattern; the
 *   pattern is discovered by the jelly, never dictated to it.
 *
 *   Common modules inlined by convention:
 *     common/alphabet_primes.pli — ordered_factor(p)/active(p): the
 *                                  emergent, self-told prime pattern
 *     common/time_crystal_core.pli — each condensed point carries a
 *                                  temporal phase of the 11D time crystal
 *
 * Traceability: src/cpp/nanobrain_brain_jelly.h
 *               (FractalCondensation — condense_everywhere,
 *                apply_prime_pattern, compute_pattern_coherence;
 *                CondensationPoint — position[11], prime_pattern,
 *                condensation_strength, temporal_phase)
 * Initial multiset: one condensation seed in the skin; vapor in every
 *                   region, so the simulator runs >= 1 step in every
 *                   membrane.
 * ==========================================================================*/

@model<psystems_basic>

/* --------------------------------------------------------------------------
 * Membrane structure (a self-similar condensation tree):
 *   skin (the supersaturated vapor bath)
 *     '- region_a : a fractal condensation region
 *     |    '- region_a1 : its self-similar child
 *     |         '- region_a11 : the grandchild (fractal depth 3)
 *     '- region_b : an independent region condensing in parallel
 *     '- primes   : the loom where the untold prime pattern emerges
 * ------------------------------------------------------------------------*/
@mu = [ [ [ []'region_a11 ]'region_a1 ]'region_a
        []'region_b
        []'primes ]'skin;

/* Sample initial multiset. */
@mskin       = condensation_seed, vapor*2;
@mregion_a   = vapor*2;
@mregion_a1  = vapor*2;
@mregion_a11 = vapor*2;
@mregion_b   = vapor*2;
@mprimes     = factor_loom, prime(2), prime(3), prime(5);

/* --------------------------------------------------------------------------
 * 9.5  Condensing everywhere at a time.
 * seed_fan  : one seed fans a condensation front into every region at once
 *             — the front is broadcast, not walked
 * condense  : a front plus vapor condenses the whole region in ONE step and
 *             emits a self-similar front deeper into the child region
 * deepen    : the child region condenses and passes the front deeper still
 *             — the same rule at every depth IS the fractal
 * ------------------------------------------------------------------------*/
[seed_fan : condensation_seed
         --> (front)in_region_a * (front)in_region_b ]'skin;

[condense : front * vapor*2
         --> crystal(a) * front ]'region_a;
[deepen_a : front --> (front)in_region_a1 ]'region_a;

[condense_a1 : front * vapor*2 --> crystal(a1) * front ]'region_a1;
[deepen_a1 : front --> (front)in_region_a11 ]'region_a1;
[condense_a11 : front * vapor*2 --> crystal(a11) ]'region_a11;

[condense_b : front * vapor*2 --> crystal(b) ]'region_b;

/* --------------------------------------------------------------------------
 * Everywhere at a time: the crystals from every depth surface together, and
 * the field is the SIMULTANEOUS union of all of them.
 * ------------------------------------------------------------------------*/
[surface : crystal(a11) --> (crystal(a11))out ]'region_a11;
[surface : crystal(a1)  --> (crystal(a1))out ]'region_a1;
[surface : crystal(a)   --> (crystal(a))out ]'region_a;
[surface : crystal(b)   --> (crystal(b))out ]'region_b;

[everywhere : crystal(a) * crystal(a1) * crystal(a11) * crystal(b)
           --> condensation_field(everywhere) ]'skin;

/* --------------------------------------------------------------------------
 * 9.5.1  The pattern of primes need not be told.
 * harvest  : each condensed crystal releases its ordered factors to the loom
 * emerge   : the loom fuses two factors into one active prime bond — NO
 *            program was given; the pattern self-organizes
 * untold   : the fused bond is the prime pattern that was never told —
 *            the jelly discovered it by condensing
 * ------------------------------------------------------------------------*/
[harvest : condensation_field(everywhere)
        --> (ordered_factor(2))in_primes ]'skin;

[emerge : factor_loom * prime(P) * ordered_factor(F)
       --> factor_loom * active(P) * bond(P,F) ]'primes;
[untold : bond(P,F) * bond(Q,G)
       --> (prime_pattern(emergent))out ]'primes;

/* --------------------------------------------------------------------------
 * The bath certifies the fractal condensation: one field condensed
 * everywhere at a time, carrying a prime pattern that needed no telling.
 * ------------------------------------------------------------------------*/
[certify : condensation_field(everywhere) * prime_pattern(emergent)
        --> fractal_condensation(self_told) ]'skin;
