/* ============================================================================
 * psystems/ch05/ch05_artificial_brain_hw.pli
 *
 * NanoBrain CH05: Big data in the garden of gardens (GOG) of meander flower: universal time crystal
 * Issue #10 — P-Lingua specification (see psystems/README.md).
 *
 * Sections: 5.5
 * Functionality: Hardware architecture of an artificial brain as communicating hardware membranes.
 * Traceability: src/cpp/nanobrain_gog.h, nanobrain_tc_transform.h, nanobrain_spontaneous.h
 * Initial multiset: sample objects in each membrane so the simulator can run
 *                   at least one evolution step.
 * ==========================================================================*/

@model<psystems_basic>

/* Membrane structure: skin with one membrane per functional unit. */
@mu = [ []'sense []'compute []'store []'act ]'skin;

@mskin = seed;
@msense = unit(sense), fuel;
@mcompute = unit(compute), fuel;
@mstore = unit(store), fuel;
@mact = unit(act), fuel;

/* --------------------------------------------------------------------------
 * Evolution rules
 * seed_dispense : the skin injects a work token into each functional membrane
 * step_%s-local : each membrane transforms its unit object and consumes fuel
 * report        : finished results are sent out to the skin
 * ------------------------------------------------------------------------*/
[seed_dispense : seed --> (work)in_sense ]'skin;
[seed_dispense : seed --> (work)in_compute ]'skin;
[seed_dispense : seed --> (work)in_store ]'skin;
[seed_dispense : seed --> (work)in_act ]'skin;
[step : work * unit(sense) * fuel --> done(sense) ]'sense;
[step : work * unit(compute) * fuel --> done(compute) ]'compute;
[step : work * unit(store) * fuel --> done(store) ]'store;
[step : work * unit(act) * fuel --> done(act) ]'act;
[report : done(sense) --> (result(sense))out ]'sense;
[report : done(compute) --> (result(compute))out ]'compute;
[report : done(store) --> (result(store))out ]'store;
[report : done(act) --> (result(act))out ]'act;
