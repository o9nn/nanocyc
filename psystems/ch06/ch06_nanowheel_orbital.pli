/* ============================================================================
 * psystems/ch06/ch06_nanowheel_orbital.pli
 *
 * NanoBrain CH06: Unprecedented technologies of nature led by harvesting the geometry of singularity
 * Issue #11 — P-Lingua specification (see psystems/README.md).
 *
 * Sections: 6.6
 * Functionality: One-to-many and many-to-one orbital computing in a nano wheel.
 * Traceability: src/cpp/nanobrain_singularity.h
 * Initial multiset: sample objects in each membrane so the simulator can run
 *                   at least one evolution step.
 * ==========================================================================*/

@model<psystems_basic>

/* Membrane structure: skin with one membrane per functional unit. */
@mu = [ []'hub []'rim ]'skin;

@mskin = seed;
@mhub = unit(hub), fuel;
@mrim = unit(rim), fuel;

/* --------------------------------------------------------------------------
 * Evolution rules
 * seed_dispense : the skin injects a work token into each functional membrane
 * step_%s-local : each membrane transforms its unit object and consumes fuel
 * report        : finished results are sent out to the skin
 * ------------------------------------------------------------------------*/
[seed_dispense : seed --> (work)in_hub ]'skin;
[seed_dispense : seed --> (work)in_rim ]'skin;
[step : work * unit(hub) * fuel --> done(hub) ]'hub;
[step : work * unit(rim) * fuel --> done(rim) ]'rim;
[report : done(hub) --> (result(hub))out ]'hub;
[report : done(rim) --> (result(rim))out ]'rim;
