/* ============================================================================
 * psystems/ch04/ch04_mechanics_comparison.pli
 *
 * NanoBrain CH04: Fractal mechanics is not quantum but original: geometric algebra for a dodecanion brain
 * Issue #9 — P-Lingua specification (see psystems/README.md).
 *
 * Sections: 4.3
 * Functionality: Classical vs quantum vs fractal mechanics: scale symmetry and scale relativity.
 * Traceability: src/cpp/nanobrain_dodecanion.h, nanobrain_fractal.h
 * Initial multiset: sample objects in each membrane so the simulator can run
 *                   at least one evolution step.
 * ==========================================================================*/

@model<psystems_basic>

/* Membrane structure: skin with one membrane per functional unit. */
@mu = [ []'classical []'quantum []'fractal ]'skin;

@mskin = seed;
@mclassical = unit(classical), fuel;
@mquantum = unit(quantum), fuel;
@mfractal = unit(fractal), fuel;

/* --------------------------------------------------------------------------
 * Evolution rules
 * seed_dispense : the skin injects a work token into each functional membrane
 * step_%s-local : each membrane transforms its unit object and consumes fuel
 * report        : finished results are sent out to the skin
 * ------------------------------------------------------------------------*/
[seed_dispense : seed --> (work)in_classical ]'skin;
[seed_dispense : seed --> (work)in_quantum ]'skin;
[seed_dispense : seed --> (work)in_fractal ]'skin;
[step : work * unit(classical) * fuel --> done(classical) ]'classical;
[step : work * unit(quantum) * fuel --> done(quantum) ]'quantum;
[step : work * unit(fractal) * fuel --> done(fractal) ]'fractal;
[report : done(classical) --> (result(classical))out ]'classical;
[report : done(quantum) --> (result(quantum))out ]'quantum;
[report : done(fractal) --> (result(fractal))out ]'fractal;
