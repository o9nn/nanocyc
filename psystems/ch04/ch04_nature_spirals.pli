/* ============================================================================
 * psystems/ch04/ch04_nature_spirals.pli
 *
 * NanoBrain CH04: Fractal mechanics is not quantum but original: geometric
 * algebra for a dodecanion brain
 * Issue #9 — P-Lingua specification (see psystems/README.md).
 *
 * Sections: 4.11 (different kinds of spirals in nature)
 * Functionality: Spirals are the visible signature of a clock growing while it
 *   turns, and nature uses several distinct kinds, each generated by a
 *   different rule of growth-per-tick. The ARCHIMEDEAN spiral adds a constant
 *   radial step per turn (equal spacing — a snail's coil of constant pitch);
 *   the LOGARITHMIC (equiangular) spiral multiplies the radius by a constant
 *   factor per turn (self-similar — the nautilus, the galaxy); the GOLDEN
 *   spiral is the logarithmic spiral whose growth factor per quarter-turn is
 *   the golden ratio phi (phyllotaxis — sunflowers, pinecones); the FERMAT
 *   (parabolic) spiral grows the radius as the square root of the angle
 *   (equal-area — the pattern of seeds packing a disc); and the HYPERBOLIC
 *   spiral shrinks the radius as the reciprocal of the angle (a pole-fall).
 *   Each kind is a spiral-generating rule family: given a seed radius and a
 *   tick, the membrane emits the next radius by that family's growth law, so
 *   the whole family is produced by iterating one rule.
 *
 *   One spirals membrane holds the five growth families as object types; a
 *   grow rule per family maps (radius, turn) to the next radius.
 * Traceability: src/cpp/nanobrain_dodecanion.h, nanobrain_fractal.h,
 *               src/cpp/nanobrain_time_crystal.h (GML spirals)
 * Initial multiset: the spirals membrane holds a seed radius and one turn
 *                   token per family plus fuel, so the simulator runs at
 *                   least one growth step for each spiral kind.
 * ==========================================================================*/

@model<psystems_basic>

/* --------------------------------------------------------------------------
 * Membrane structure (4.11): five spiral families under one membrane.
 *
 *   skin
 *     '- spirals : the five growth families, each a rule mapping (radius,
 *                  turn) -> next radius
 * ------------------------------------------------------------------------*/
@mu = [ []'spirals ]'skin;

/* Sample initial multiset: a seed radius and a turn token per family. */
@mskin    = grow;
@mspirals = seed(r0),
            turn(archimedean), turn(logarithmic), turn(golden),
            turn(fermat), turn(hyperbolic),
            fuel;

/* --------------------------------------------------------------------------
 * Evolution rules
 *
 * sow           : the skin sows the growth token into the spiral membrane
 * grow_archimedean : ARCHIMEDEAN — radius += constant per turn; equal spacing
 *                 (constant-pitch coil)
 * grow_logarithmic : LOGARITHMIC — radius *= constant per turn; self-similar
 *                 (nautilus, galaxy)
 * grow_golden   : GOLDEN — radius *= phi per quarter-turn; phyllotaxis
 *                 (sunflower, pinecone)
 * grow_fermat   : FERMAT — radius ~ sqrt(angle); equal-area seed packing
 * grow_hyperbolic : HYPERBOLIC — radius ~ 1/angle; the pole-fall spiral
 * classify      : the grown radii are tagged by family so the skin can read
 *                 off which kind of spiral each rule produced
 * ------------------------------------------------------------------------*/
[sow : grow --> (grow)in_spirals ]'skin;

[grow_archimedean : seed(r0) * turn(archimedean) * fuel --> radius(r_plus_c) ]'spirals;
[grow_logarithmic : seed(r0) * turn(logarithmic) --> radius(r_times_k) ]'spirals;
[grow_golden      : seed(r0) * turn(golden) --> radius(r_times_phi) ]'spirals;
[grow_fermat      : seed(r0) * turn(fermat) --> radius(sqrt_angle) ]'spirals;
[grow_hyperbolic  : seed(r0) * turn(hyperbolic) --> radius(recip_angle) ]'spirals;

[classify : radius(r_plus_c) --> spiral(archimedean) ]'spirals;
[classify : radius(r_times_k) --> spiral(logarithmic) ]'spirals;
[classify : radius(r_times_phi) --> spiral(golden) ]'spirals;
[classify : radius(sqrt_angle) --> spiral(fermat) ]'spirals;
[classify : radius(recip_angle) --> spiral(hyperbolic) ]'spirals;

[report : spiral(archimedean) --> (result(archimedean))out ]'spirals;
[report : spiral(logarithmic) --> (result(logarithmic))out ]'spirals;
[report : spiral(golden) --> (result(golden))out ]'spirals;
[report : spiral(fermat) --> (result(fermat))out ]'spirals;
[report : spiral(hyperbolic) --> (result(hyperbolic))out ]'spirals;
