/* ============================================================================
 * psystems/ch04/ch04_geometric_algebra_marriage.pli
 *
 * NanoBrain CH04: Fractal mechanics is not quantum but original: geometric algebra for a dodecanion brain
 * Issue #9 — P-Lingua specification (see psystems/README.md).
 *
 * Sections: 4.12
 * Functionality: A marriage between fractal mechanics and geometric algebra.
 * Traceability: src/cpp/nanobrain_dodecanion.h, nanobrain_fractal.h
 * Initial multiset: sample objects in each membrane so the simulator can run
 *                   at least one evolution step.
 * ==========================================================================*/

@model<psystems_basic>

/* Membrane structure: skin with one membrane per functional unit. */
@mu = [ []'fm_side []'ga_side ]'skin;

@mskin = seed;
@mfm_side = unit(fm_side), fuel;
@mga_side = unit(ga_side), fuel;

/* --------------------------------------------------------------------------
 * Evolution rules
 * seed_dispense : the skin injects a work token into each functional membrane
 * step_%s-local : each membrane transforms its unit object and consumes fuel
 * report        : finished results are sent out to the skin
 * ------------------------------------------------------------------------*/
[seed_dispense : seed --> (work)in_fm_side ]'skin;
[seed_dispense : seed --> (work)in_ga_side ]'skin;
[step : work * unit(fm_side) * fuel --> done(fm_side) ]'fm_side;
[step : work * unit(ga_side) * fuel --> done(ga_side) ]'ga_side;
[report : done(fm_side) --> (result(fm_side))out ]'fm_side;
[report : done(ga_side) --> (result(ga_side))out ]'ga_side;
