/* ============================================================================
 * psystems/ch03/ch03_ppm_metric9_lattice.pli
 *
 * NanoBrain CH03: Phase prime metric (PPM) links all symmetries
 * Issue #8 — P-Lingua specification (see psystems/README.md).
 *
 * Sections: 3.10
 * Functionality: Metric 9: lattice group of primes (twin, cousin, co-primes, Gaussian primes).
 * Traceability: src/cpp/nanobrain_ppm.h, nanobrain_ppm.cpp
 * Initial multiset: sample objects in each membrane so the simulator can run
 *                   at least one evolution step.
 * ==========================================================================*/

@model<psystems_basic>

/* Membrane structure: skin with one membrane per functional unit. */
@mu = [ []'twin []'cousin []'coprime []'gaussian ]'skin;

@mskin = seed;
@mtwin = unit(twin), fuel;
@mcousin = unit(cousin), fuel;
@mcoprime = unit(coprime), fuel;
@mgaussian = unit(gaussian), fuel;

/* --------------------------------------------------------------------------
 * Evolution rules
 * seed_dispense : the skin injects a work token into each functional membrane
 * step_%s-local : each membrane transforms its unit object and consumes fuel
 * report        : finished results are sent out to the skin
 * ------------------------------------------------------------------------*/
[seed_dispense : seed --> (work)in_twin ]'skin;
[seed_dispense : seed --> (work)in_cousin ]'skin;
[seed_dispense : seed --> (work)in_coprime ]'skin;
[seed_dispense : seed --> (work)in_gaussian ]'skin;
[step : work * unit(twin) * fuel --> done(twin) ]'twin;
[step : work * unit(cousin) * fuel --> done(cousin) ]'cousin;
[step : work * unit(coprime) * fuel --> done(coprime) ]'coprime;
[step : work * unit(gaussian) * fuel --> done(gaussian) ]'gaussian;
[report : done(twin) --> (result(twin))out ]'twin;
[report : done(cousin) --> (result(cousin))out ]'cousin;
[report : done(coprime) --> (result(coprime))out ]'coprime;
[report : done(gaussian) --> (result(gaussian))out ]'gaussian;
