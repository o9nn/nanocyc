/* ============================================================================
 * psystems/ch03/ch03_ppm_evolution.pli
 *
 * NanoBrain CH03: Phase prime metric (PPM) links all symmetries
 * Issue #8 — P-Lingua specification (see psystems/README.md).
 *
 * Sections: 3.13-3.14
 * Functionality: Hidden physical significance of the 15 primes when the PPM evolves a time crystal; how to use a PPM (workflow membrane).
 * Traceability: src/cpp/nanobrain_ppm.h, nanobrain_ppm.cpp
 * Initial multiset: sample objects in each membrane so the simulator can run
 *                   at least one evolution step.
 * ==========================================================================*/

@model<psystems_basic>

/* Membrane structure: skin with one membrane per functional unit. */
@mu = [ []'evolve []'workflow ]'skin;

@mskin = seed;
@mevolve = unit(evolve), fuel;
@mworkflow = unit(workflow), fuel;

/* --------------------------------------------------------------------------
 * Evolution rules
 * seed_dispense : the skin injects a work token into each functional membrane
 * step_%s-local : each membrane transforms its unit object and consumes fuel
 * report        : finished results are sent out to the skin
 * ------------------------------------------------------------------------*/
[seed_dispense : seed --> (work)in_evolve ]'skin;
[seed_dispense : seed --> (work)in_workflow ]'skin;
[step : work * unit(evolve) * fuel --> done(evolve) ]'evolve;
[step : work * unit(workflow) * fuel --> done(workflow) ]'workflow;
[report : done(evolve) --> (result(evolve))out ]'evolve;
[report : done(workflow) --> (result(workflow))out ]'workflow;
