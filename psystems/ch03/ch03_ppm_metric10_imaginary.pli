/* ============================================================================
 * psystems/ch03/ch03_ppm_metric10_imaginary.pli
 *
 * NanoBrain CH03: Phase prime metric (PPM) links all symmetries
 * Issue #8 — P-Lingua specification (see psystems/README.md).
 *
 * Sections: 3.11
 * Functionality: Metric 10: multilayer imaginary operations on real integers build a new pattern.
 * Traceability: src/cpp/nanobrain_ppm.h, nanobrain_ppm.cpp
 * Initial multiset: sample objects in each membrane so the simulator can run
 *                   at least one evolution step.
 * ==========================================================================*/

@model<psystems_basic>

/* Membrane structure: skin with one membrane per functional unit. */
@mu = [ []'real_layer []'imag_layer ]'skin;

@mskin = seed;
@mreal_layer = unit(real_layer), fuel;
@mimag_layer = unit(imag_layer), fuel;

/* --------------------------------------------------------------------------
 * Evolution rules
 * seed_dispense : the skin injects a work token into each functional membrane
 * step_%s-local : each membrane transforms its unit object and consumes fuel
 * report        : finished results are sent out to the skin
 * ------------------------------------------------------------------------*/
[seed_dispense : seed --> (work)in_real_layer ]'skin;
[seed_dispense : seed --> (work)in_imag_layer ]'skin;
[step : work * unit(real_layer) * fuel --> done(real_layer) ]'real_layer;
[step : work * unit(imag_layer) * fuel --> done(imag_layer) ]'imag_layer;
[report : done(real_layer) --> (result(real_layer))out ]'real_layer;
[report : done(imag_layer) --> (result(imag_layer))out ]'imag_layer;
