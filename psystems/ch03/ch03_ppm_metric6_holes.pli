/* ============================================================================
 * psystems/ch03/ch03_ppm_metric6_holes.pli
 *
 * NanoBrain CH03: Phase prime metric (PPM) links all symmetries
 * Issue #8 — P-Lingua specification (see psystems/README.md).
 *
 * Sections: 3.7
 * Functionality: Metric 6: empty space in the divisor ordering phase plot finds holes.
 * Traceability: src/cpp/nanobrain_ppm.h, nanobrain_ppm.cpp
 * Initial multiset: sample objects in each membrane so the simulator can run
 *                   at least one evolution step.
 * ==========================================================================*/

@model<psystems_basic>

/* Membrane structure: skin with one membrane per functional unit. */
@mu = [ []'metric6 ]'skin;

@mskin = seed;
@mmetric6 = unit(metric6), fuel;

/* --------------------------------------------------------------------------
 * Evolution rules
 * seed_dispense : the skin injects a work token into each functional membrane
 * step_%s-local : each membrane transforms its unit object and consumes fuel
 * report        : finished results are sent out to the skin
 * ------------------------------------------------------------------------*/
[seed_dispense : seed --> (work)in_metric6 ]'skin;
[step : work * unit(metric6) * fuel --> done(metric6) ]'metric6;
[report : done(metric6) --> (result(metric6))out ]'metric6;
