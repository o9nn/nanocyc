/* ============================================================================
 * psystems/ch10/ch10_11d_wiring.pli
 *
 * NanoBrain CH10: Uploading consciousness: the evolution of conscious machines of the future
 * Issue #15 — P-Lingua specification (see psystems/README.md).
 *
 * Sections: 10.6
 * Functionality: Wiring with time needs to fold a paper in 11D: dimensional-folding rules.
 * Traceability: src/cpp/nanobrain_consciousness.h, nanobrain_ontogenesis.h
 * Initial multiset: sample objects in each membrane so the simulator can run
 *                   at least one evolution step.
 * ==========================================================================*/

@model<psystems_basic>

/* Membrane structure: skin with one membrane per functional unit. */
@mu = [ []'fold ]'skin;

@mskin = seed;
@mfold = unit(fold), fuel;

/* --------------------------------------------------------------------------
 * Evolution rules
 * seed_dispense : the skin injects a work token into each functional membrane
 * step_%s-local : each membrane transforms its unit object and consumes fuel
 * report        : finished results are sent out to the skin
 * ------------------------------------------------------------------------*/
[seed_dispense : seed --> (work)in_fold ]'skin;
[step : work * unit(fold) * fuel --> done(fold) ]'fold;
[report : done(fold) --> (result(fold))out ]'fold;
