/* ============================================================================
 * psystems/ch02/ch02_gml_vs_software.pli
 *
 * NanoBrain CH02: Replacing Turing tape with a Fractal tape: FIT & GML
 * Issue #7 — P-Lingua specification (see psystems/README.md).
 *
 * Sections: 2.8, 2.8.1, 2.9
 * Functionality: GML vs software algorithms; hypercomputing / super-Turing hypothesis; creation of a non-argument.
 * Traceability: src/cpp/nanobrain_fractal_tape.h, nanobrain_fractal.h
 * Initial multiset: sample objects in each membrane so the simulator can run
 *                   at least one evolution step.
 * ==========================================================================*/

@model<psystems_basic>

/* Membrane structure: skin with one membrane per functional unit. */
@mu = [ []'gml_side []'software_side []'hyper ]'skin;

@mskin = seed;
@mgml_side = unit(gml_side), fuel;
@msoftware_side = unit(software_side), fuel;
@mhyper = unit(hyper), fuel;

/* --------------------------------------------------------------------------
 * Evolution rules
 * seed_dispense : the skin injects a work token into each functional membrane
 * step_%s-local : each membrane transforms its unit object and consumes fuel
 * report        : finished results are sent out to the skin
 * ------------------------------------------------------------------------*/
[seed_dispense : seed --> (work)in_gml_side ]'skin;
[seed_dispense : seed --> (work)in_software_side ]'skin;
[seed_dispense : seed --> (work)in_hyper ]'skin;
[step : work * unit(gml_side) * fuel --> done(gml_side) ]'gml_side;
[step : work * unit(software_side) * fuel --> done(software_side) ]'software_side;
[step : work * unit(hyper) * fuel --> done(hyper) ]'hyper;
[report : done(gml_side) --> (result(gml_side))out ]'gml_side;
[report : done(software_side) --> (result(software_side))out ]'software_side;
[report : done(hyper) --> (result(hyper))out ]'hyper;
