/* ============================================================================
 * psystems/ch07/ch07_connectome_primes.pli
 *
 * NanoBrain CH07: A complete, integrated time crystal model of a human brain
 * Issue #12 — P-Lingua specification (see psystems/README.md).
 *
 * Sections: 7.4
 * Functionality: Primes in the connectome, spinal cord, amygdala nucleus and cortical column.
 * Traceability: src/cpp/nanobrain_brain_model.h
 * Initial multiset: sample objects in each membrane so the simulator can run
 *                   at least one evolution step.
 * ==========================================================================*/

@model<psystems_basic>

/* Membrane structure: skin with one membrane per functional unit. */
@mu = [ []'connectome []'spinal []'amygdala []'column ]'skin;

@mskin = seed;
@mconnectome = unit(connectome), fuel;
@mspinal = unit(spinal), fuel;
@mamygdala = unit(amygdala), fuel;
@mcolumn = unit(column), fuel;

/* --------------------------------------------------------------------------
 * Evolution rules
 * seed_dispense : the skin injects a work token into each functional membrane
 * step_%s-local : each membrane transforms its unit object and consumes fuel
 * report        : finished results are sent out to the skin
 * ------------------------------------------------------------------------*/
[seed_dispense : seed --> (work)in_connectome ]'skin;
[seed_dispense : seed --> (work)in_spinal ]'skin;
[seed_dispense : seed --> (work)in_amygdala ]'skin;
[seed_dispense : seed --> (work)in_column ]'skin;
[step : work * unit(connectome) * fuel --> done(connectome) ]'connectome;
[step : work * unit(spinal) * fuel --> done(spinal) ]'spinal;
[step : work * unit(amygdala) * fuel --> done(amygdala) ]'amygdala;
[step : work * unit(column) * fuel --> done(column) ]'column;
[report : done(connectome) --> (result(connectome))out ]'connectome;
[report : done(spinal) --> (result(spinal))out ]'spinal;
[report : done(amygdala) --> (result(amygdala))out ]'amygdala;
[report : done(column) --> (result(column))out ]'column;
