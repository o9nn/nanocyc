/* ============================================================================
 * psystems/ch07/ch07_meander_gog_expressions.pli
 *
 * NanoBrain CH07: A complete, integrated time crystal model of a human brain
 * Issue #12 — P-Lingua specification (see psystems/README.md).
 *
 * Sections: 7.12, 7.12.1
 * Functionality: Time crystal made meander flower to a garden of gardens; 12 dodecanions and 8 octonions build 20 conscious human expressions.
 * Traceability: src/cpp/nanobrain_brain_model.h
 * Initial multiset: sample objects in each membrane so the simulator can run
 *                   at least one evolution step.
 * ==========================================================================*/

@model<psystems_basic>

/* Membrane structure: skin with one membrane per functional unit. */
@mu = [ []'meander []'gog []'expressions_20 ]'skin;

@mskin = seed;
@mmeander = unit(meander), fuel;
@mgog = unit(gog), fuel;
@mexpressions_20 = unit(expressions_20), fuel;

/* --------------------------------------------------------------------------
 * Evolution rules
 * seed_dispense : the skin injects a work token into each functional membrane
 * step_%s-local : each membrane transforms its unit object and consumes fuel
 * report        : finished results are sent out to the skin
 * ------------------------------------------------------------------------*/
[seed_dispense : seed --> (work)in_meander ]'skin;
[seed_dispense : seed --> (work)in_gog ]'skin;
[seed_dispense : seed --> (work)in_expressions_20 ]'skin;
[step : work * unit(meander) * fuel --> done(meander) ]'meander;
[step : work * unit(gog) * fuel --> done(gog) ]'gog;
[step : work * unit(expressions_20) * fuel --> done(expressions_20) ]'expressions_20;
[report : done(meander) --> (result(meander))out ]'meander;
[report : done(gog) --> (result(gog))out ]'gog;
[report : done(expressions_20) --> (result(expressions_20))out ]'expressions_20;
