/* ============================================================================
 * psystems/ch07/ch07_subcortical_primes.pli
 *
 * NanoBrain CH07: A complete, integrated time crystal model of a human brain
 * Issue #12 — P-Lingua specification (see psystems/README.md).
 *
 * Sections: 7.3
 * Functionality: Primes in the cerebellum, hippocampus and hypothalamus.
 * Traceability: src/cpp/nanobrain_brain_model.h
 * Initial multiset: sample objects in each membrane so the simulator can run
 *                   at least one evolution step.
 * ==========================================================================*/

@model<psystems_basic>

/* Membrane structure: skin with one membrane per functional unit. */
@mu = [ []'cerebellum []'hippocampus []'hypothalamus ]'skin;

@mskin = seed;
@mcerebellum = unit(cerebellum), fuel;
@mhippocampus = unit(hippocampus), fuel;
@mhypothalamus = unit(hypothalamus), fuel;

/* --------------------------------------------------------------------------
 * Evolution rules
 * seed_dispense : the skin injects a work token into each functional membrane
 * step_%s-local : each membrane transforms its unit object and consumes fuel
 * report        : finished results are sent out to the skin
 * ------------------------------------------------------------------------*/
[seed_dispense : seed --> (work)in_cerebellum ]'skin;
[seed_dispense : seed --> (work)in_hippocampus ]'skin;
[seed_dispense : seed --> (work)in_hypothalamus ]'skin;
[step : work * unit(cerebellum) * fuel --> done(cerebellum) ]'cerebellum;
[step : work * unit(hippocampus) * fuel --> done(hippocampus) ]'hippocampus;
[step : work * unit(hypothalamus) * fuel --> done(hypothalamus) ]'hypothalamus;
[report : done(cerebellum) --> (result(cerebellum))out ]'cerebellum;
[report : done(hippocampus) --> (result(hippocampus))out ]'hippocampus;
[report : done(hypothalamus) --> (result(hypothalamus))out ]'hypothalamus;
