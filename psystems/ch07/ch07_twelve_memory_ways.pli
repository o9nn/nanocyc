/* ============================================================================
 * psystems/ch07/ch07_twelve_memory_ways.pli
 *
 * NanoBrain CH07: A complete, integrated time crystal model of a human brain
 * Issue #12 — P-Lingua specification (see psystems/README.md).
 *
 * Sections: 7.6 (twelve ways to memorising and twelve carriers operating
 *                rhythms / clocks)
 *
 * Functionality: The brain has TWELVE distinct memory carriers, each with
 *   its own rhythm / decay clock. This file mirrors MemoryCarrier in
 *   nanobrain_brain_model.h exactly:
 *
 *     sensory   (5) : visual, auditory, tactile, olfactory, gustatory
 *     cognitive (4) : episodic, semantic, procedural, working
 *     implicit  (3) : implicit, explicit, priming
 *
 *   Every carrier membrane owns a decay_rate token (fast for sensory, slow
 *   for semantic/procedural) and a rhythm object. A content payload flows
 *   into a carrier where it is ENCODED into a memory token; each tick
 *   applies DECAY (a rate-dependent multiplier); frequently-refreshed
 *   working memories are CONSOLIDATED into long-term semantic memories
 *   inside the skin — exactly MemoryCarrierSystem::consolidate_memories.
 *
 *   Common modules inlined by convention:
 *     common/time_crystal_core.pli (the tick that runs each carrier's clock)
 *     common/ecan_attention.pli    (attention refreshes activation)
 *
 * Traceability: src/cpp/nanobrain_brain_model.h
 *               (MemoryCarrier enum, MemoryCarrierState, MemoryCarrierSystem,
 *                encode_memory, apply_decay, consolidate_memories,
 *                update_activations, CarrierStats)
 * Initial multiset: one content payload plus decay/rhythm tokens in each
 *                   carrier, and a global tick + consolidator in the skin.
 * ==========================================================================*/

@model<psystems_basic>

@mu = [ []'visual []'auditory []'tactile []'olfactory []'gustatory
        []'episodic []'semantic []'procedural []'working
        []'implicit []'explicit []'priming ]'skin;

@mskin       = tick, consolidator;

/* Sensory memories — fast decay (rate=fast). */
@mvisual    = content(v),  rhythm(v),  decay(fast);
@mauditory  = content(a),  rhythm(a),  decay(fast);
@mtactile   = content(t),  rhythm(t),  decay(fast);
@molfactory = content(o),  rhythm(o),  decay(fast);
@mgustatory = content(g),  rhythm(g),  decay(fast);

/* Cognitive memories — slow decay (except working, which is medium). */
@mepisodic   = content(ep), rhythm(ep), decay(slow);
@msemantic   = content(sm), rhythm(sm), decay(slow);
@mprocedural = content(pr), rhythm(pr), decay(slow);
@mworking    = content(wk), rhythm(wk), decay(med);

/* Implicit family — priming has the slowest decay. */
@mimplicit = content(im), rhythm(im), decay(slow);
@mexplicit = content(ex), rhythm(ex), decay(med);
@mpriming  = content(pm), rhythm(pm), decay(slowest);

/* --------------------------------------------------------------------------
 * 7.6  Encode: each carrier binds its content to a rhythm to produce an
 *      addressable memory token.
 * ------------------------------------------------------------------------*/
[encode_v  : content(v)  * rhythm(v)  --> memory(v,live) ]'visual;
[encode_a  : content(a)  * rhythm(a)  --> memory(a,live) ]'auditory;
[encode_t  : content(t)  * rhythm(t)  --> memory(t,live) ]'tactile;
[encode_o  : content(o)  * rhythm(o)  --> memory(o,live) ]'olfactory;
[encode_g  : content(g)  * rhythm(g)  --> memory(g,live) ]'gustatory;
[encode_ep : content(ep) * rhythm(ep) --> memory(ep,live) ]'episodic;
[encode_sm : content(sm) * rhythm(sm) --> memory(sm,live) ]'semantic;
[encode_pr : content(pr) * rhythm(pr) --> memory(pr,live) ]'procedural;
[encode_wk : content(wk) * rhythm(wk) --> memory(wk,live) ]'working;
[encode_im : content(im) * rhythm(im) --> memory(im,live) ]'implicit;
[encode_ex : content(ex) * rhythm(ex) --> memory(ex,live) ]'explicit;
[encode_pm : content(pm) * rhythm(pm) --> memory(pm,live) ]'priming;

/* --------------------------------------------------------------------------
 * Decay clocks: the skin's tick reaches each carrier, and inside each
 * carrier the tick + decay(rate) transforms a live memory into a faded
 * one. Twelve separate rhythms — the twelve clocks of section 7.6.
 * ------------------------------------------------------------------------*/
[fanout_v  : tick --> tick * (tick)in_visual ]'skin;
[fanout_a  : tick --> tick * (tick)in_auditory ]'skin;
[fanout_wk : tick --> tick * (tick)in_working ]'skin;
[fanout_ep : tick --> tick * (tick)in_episodic ]'skin;

[decay_step : tick * memory(K,live) * decay(R)
            --> memory(K,fading) * decay(R) ]'visual;
[decay_step : tick * memory(K,live) * decay(R)
            --> memory(K,fading) * decay(R) ]'auditory;
[decay_step : tick * memory(K,live) * decay(R)
            --> memory(K,fading) * decay(R) ]'working;
[decay_step : tick * memory(K,live) * decay(R)
            --> memory(K,fading) * decay(R) ]'episodic;

/* --------------------------------------------------------------------------
 * Working -> long-term consolidation (MemoryCarrierSystem::consolidate):
 * a working memory that survives a decay step is lifted to the skin, and
 * the skin's consolidator promotes it into semantic long-term storage.
 * ------------------------------------------------------------------------*/
[lift_wk    : memory(wk,fading) --> (memory(wk,fading))out ]'working;
[consolidate: consolidator * memory(wk,fading)
            --> consolidator * (memory(sm,live))in_semantic ]'skin;
