/* ============================================================================
 * psystems/ch07/ch07_triplet_cage.pli
 *
 * NanoBrain CH07: A complete, integrated time crystal model of a human brain
 * Issue #12 — P-Lingua specification (see psystems/README.md).
 *
 * Sections: 7.1, 7.1.1, 7.1.2
 *
 * Functionality: The brain is the engineering of PRIME NUMBERS embedded in a
 *   TRIPLET-OF-TRIPLETS cage. Nine ordered primes fill three prime triplets;
 *   the three triplets themselves form a higher-order triplet — a cage of
 *   3 x 3 = 9 primes that the brain uses to encode every sensory event.
 *
 *   Around this cage FOUR, EIGHT and TWELVE imaginary worlds work together:
 *     - the 4-world  = quaternion  (i, j, k)
 *     - the 8-world  = octonion    (i1..i7)
 *     - the 12-world = dodecanion  (i1..i11)
 *   Primes flow from the triplet cage into the three imaginary worlds; each
 *   world composes them into hypernumbers of its own dimensionality.
 *
 *   A SINGULARITY ON A SPHERE (7.1.2) is the key to a clock of a time
 *   crystal: a singular point on the closed sphere seeds a rotation whose
 *   period IS the time-crystal clock. Once the singularity is placed the
 *   cage begins to tick.
 *
 *   Common modules inlined by convention:
 *     common/alphabet_primes.pli   — prime objects p1..p9 (2,3,5,7,11,13,17,19,23)
 *     common/time_crystal_core.pli — singularity_point seeds a tick
 *     common/hypernumbers.pli      — quaternion / octonion / dodecanion objects
 *
 * Traceability: src/cpp/nanobrain_brain_model.h
 *               (IntegratedBrainModel — the triplet cage is the substrate that
 *               feeds SensoryPrimeMapper and ConsciousnessExpressionEngine),
 *               src/cpp/nanobrain_time_crystal.h (11D quantum manifold),
 *               src/cpp/nanobrain_dodecanion.h  (12-imaginary world).
 * Initial multiset: three triplets each loaded with three ordered primes,
 *                   a singularity_point on the sphere, and empty world
 *                   membranes ready to receive prime tokens.
 * ==========================================================================*/

@model<psystems_basic>

/* Three prime triplets and three imaginary-world membranes hang inside the
 * cage; the sphere sits alongside them and carries the singularity. */
@mu = [ []'triplet_1 []'triplet_2 []'triplet_3
        []'world_4 []'world_8 []'world_12
        []'sphere ]'skin;

@mskin      = cage_ready;
@mtriplet_1 = prime(2), prime(3), prime(5);
@mtriplet_2 = prime(7), prime(11), prime(13);
@mtriplet_3 = prime(17), prime(19), prime(23);
@mworld_4   = quaternion_seed;
@mworld_8   = octonion_seed;
@mworld_12  = dodecanion_seed;
@msphere    = singularity_point;

/* --------------------------------------------------------------------------
 * 7.1  Triplet-of-triplets cage: emit an ordered prime triplet from each
 *      triplet membrane, then bind the three triplets into ONE cage token.
 * ------------------------------------------------------------------------*/
[form_triplet_1 : prime(2) * prime(3) * prime(5)
                --> (triplet(2,3,5))out ]'triplet_1;
[form_triplet_2 : prime(7) * prime(11) * prime(13)
                --> (triplet(7,11,13))out ]'triplet_2;
[form_triplet_3 : prime(17) * prime(19) * prime(23)
                --> (triplet(17,19,23))out ]'triplet_3;
[bind_cage      : cage_ready * triplet(2,3,5) * triplet(7,11,13) * triplet(17,19,23)
                --> cage(9) ]'skin;

/* --------------------------------------------------------------------------
 * 7.1.1  Four, eight and twelve imaginary worlds work together.
 *        The cage feeds prime tokens into the three worlds; each world
 *        assembles a hypernumber of its own dimension from those primes.
 *        Four dispatch rules are needed because the worlds are siblings —
 *        the cage (in the skin) sends primes IN to each world membrane.
 * ------------------------------------------------------------------------*/
[dispatch_q : cage(9) --> cage(9) * (prime_token)in_world_4 ]'skin;
[dispatch_o : cage(9) --> cage(9) * (prime_token)in_world_8 ]'skin;
[dispatch_d : cage(9) --> cage(9) * (prime_token)in_world_12 ]'skin;

[compose_q : prime_token * quaternion_seed  --> quaternion(4) ]'world_4;
[compose_o : prime_token * octonion_seed    --> octonion(8) ]'world_8;
[compose_d : prime_token * dodecanion_seed  --> dodecanion(12) ]'world_12;

/* --------------------------------------------------------------------------
 * 7.1.2  Singularity on a sphere is the key to a time-crystal clock.
 *        The singular point on the closed sphere spawns a tick pulse; the
 *        tick returns to the skin where it drives the cage to fire a clock
 *        cycle, integrating the three world-hypernumbers into one composite
 *        cage state that the rest of the brain model consumes.
 * ------------------------------------------------------------------------*/
[seed_clock : singularity_point --> singularity_point * (tick)out ]'sphere;
[fire_cage  : tick * cage(9) --> (clock_pulse)in_world_4
                              * (clock_pulse)in_world_8
                              * (clock_pulse)in_world_12 ]'skin;
[emit_q : clock_pulse * quaternion(4)  --> (world_state(q))out ]'world_4;
[emit_o : clock_pulse * octonion(8)    --> (world_state(o))out ]'world_8;
[emit_d : clock_pulse * dodecanion(12) --> (world_state(d))out ]'world_12;
[integrate : world_state(q) * world_state(o) * world_state(d)
           --> (cage_state(triplet_of_triplets))out ]'skin;
