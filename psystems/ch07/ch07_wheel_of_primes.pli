/* ============================================================================
 * psystems/ch07/ch07_wheel_of_primes.pli
 *
 * NanoBrain CH07: A complete, integrated time crystal model of a human brain
 * Issue #12 — P-Lingua specification (see psystems/README.md).
 *
 * Sections: 7.7, 7.7.1-7.7.2
 * Functionality: The brain's wheel of primes: eight sensors holding the cross-over magic of the octonion; eight mathematical operators running two orthogonal math engines.
 * Traceability: src/cpp/nanobrain_brain_model.h
 * Initial multiset: sample objects in each membrane so the simulator can run
 *                   at least one evolution step.
 * ==========================================================================*/

@model<psystems_basic>

/* Membrane structure: skin with one membrane per functional unit. */
@mu = [ []'wheel []'sensors_8 []'engine_a []'engine_b ]'skin;

@mskin = seed;
@mwheel = unit(wheel), fuel;
@msensors_8 = unit(sensors_8), fuel;
@mengine_a = unit(engine_a), fuel;
@mengine_b = unit(engine_b), fuel;

/* --------------------------------------------------------------------------
 * Evolution rules
 * seed_dispense : the skin injects a work token into each functional membrane
 * step_%s-local : each membrane transforms its unit object and consumes fuel
 * report        : finished results are sent out to the skin
 * ------------------------------------------------------------------------*/
[seed_dispense : seed --> (work)in_wheel ]'skin;
[seed_dispense : seed --> (work)in_sensors_8 ]'skin;
[seed_dispense : seed --> (work)in_engine_a ]'skin;
[seed_dispense : seed --> (work)in_engine_b ]'skin;
[step : work * unit(wheel) * fuel --> done(wheel) ]'wheel;
[step : work * unit(sensors_8) * fuel --> done(sensors_8) ]'sensors_8;
[step : work * unit(engine_a) * fuel --> done(engine_a) ]'engine_a;
[step : work * unit(engine_b) * fuel --> done(engine_b) ]'engine_b;
[report : done(wheel) --> (result(wheel))out ]'wheel;
[report : done(sensors_8) --> (result(sensors_8))out ]'sensors_8;
[report : done(engine_a) --> (result(engine_a))out ]'engine_a;
[report : done(engine_b) --> (result(engine_b))out ]'engine_b;
